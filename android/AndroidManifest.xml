<?xml version="1.0" encoding="utf-8"?>
<!-- 药品管家 · Android 壳
     ★ 2026-11-20 起要 INTERNET 权限了 —— 用户要求「桌面版和手机、网页互联，在同一个局域网里」。
       所以那句话得改成现在的样子，别让后面的人以为还是纯离线：
       **只在局域网内连你自己那台电脑（数据台，默认 8730），不访问互联网，也不上报任何东西。**
       页面本身仍然不联外网；联网只发生在「同步」和「检查新页面」这两件事上。
     ★ usesCleartextTraffic：局域网是 http://192.168.x.x，不放行的话 Android 9+ 直接掐断。
     ★ targetSdk 33：Android 14 起禁止安装 targetSdk < 23 的包；
       33 也刚好让 `android:enableOnBackInvokedCallback` 这个属性成立 ——
       我们要显式关掉预测性返回，好让返回键先去关页面上开着的弹窗。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaotuji.drugkeeper"
    android:versionCode="37"
    android:versionName="4.6">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">

        <!-- exported 必写：targetSdk ≥31 时带 intent-filter 的组件漏了它，包**装不上** -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
